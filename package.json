{
  "name": "pagecat",
  "private": true,
  "version": "2.13.0",
  "type": "module",
  "description": "PageCat — a cozy, skeuomorphic PDF reading room with highlights, notes and an AI reading companion.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "tsc --noEmit",
    "prepare": "node scripts/prepare-assets.mjs",
    "deploy:preview": "bash scripts/deploy-preview.sh"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.9",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^0.545.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
